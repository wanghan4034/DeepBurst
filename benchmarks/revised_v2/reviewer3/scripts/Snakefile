        '''


# ============================================================
# 3. Align FASTQ to mm9
# Using bwa aln/samse for short-read ChIP-seq
# ============================================================

rule bwa_aln:
    input:
        fastq = 'extra/datasets/mouse/fastq/{acc}.fastq.gz',
        bwt = mm9_fa + '.bwt',
        pac = mm9_fa + '.pac',
        ann = mm9_fa + '.ann',
        amb = mm9_fa + '.amb',
        sa = mm9_fa + '.sa'
    output:
        sai = temp('extra/datasets/mouse/chip_bam/{acc}.mm9.sai')
    threads:
        4
    benchmark:
        'benchmarks/mouse/bwa_aln/{acc}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.sai})

        bwa aln \
            -t {threads} \
            {mm9_fa} \
            {input.fastq} \
            > {output.sai}
        '''


rule bwa_samse:
    input:
        fastq = 'extra/datasets/mouse/fastq/{acc}.fastq.gz',
        sai = 'extra/datasets/mouse/chip_bam/{acc}.mm9.sai'
    output:
        sam = temp('extra/datasets/mouse/chip_bam/{acc}.mm9.sam')
    benchmark:
        'benchmarks/mouse/bwa_samse/{acc}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.sam})

        bwa samse \
            {mm9_fa} \
            {input.sai} \
            {input.fastq} \
            > {output.sam}
        '''


rule sam_to_bam:
    input:
        sam = 'extra/datasets/mouse/chip_bam/{acc}.mm9.sam'
    output:
        bam = temp('extra/datasets/mouse/chip_bam/{acc}.mm9.bam')
    benchmark:
        'benchmarks/mouse/sam_to_bam/{acc}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.bam})

        samtools view \
            -bS \
            {input.sam} \
            > {output.bam}
        '''


rule sambamba_sort_mouse:
    input:
        bam = 'extra/datasets/mouse/chip_bam/{acc}.mm9.bam'
    output:
        bam = 'extra/datasets/mouse/chip_bam/{acc}.mm9.sorted.bam'
    threads:
        4
    benchmark:
        'benchmarks/mouse/sambamba_sort/{acc}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.bam})

        sambamba sort \
            -o {output.bam} \
            -t {threads} \
            --tmpdir . \
            {input.bam}
        '''


rule sambamba_index_mouse:
    input:
        bam = 'extra/datasets/mouse/chip_bam/{acc}.mm9.sorted.bam'
    output:
