    shell:
        r'''
        sambamba index \
            -t {threads} \
            {input.bam}
        '''


# ============================================================
# 4. Truncate aligned reads to 36 bp
# Output BED6: chrom, start, end, read_id, mapq, strand
# ============================================================

rule bam_to_36bp_bed:
    input:
        bam = 'extra/datasets/mouse/chip_bam/{acc}.mm9.sorted.bam',
        bai = 'extra/datasets/mouse/chip_bam/{acc}.mm9.sorted.bam.bai'
    output:
        bed = 'extra/datasets/mouse/chip_bed36/{acc}.mm9.36bp.bed'
    benchmark:
        'benchmarks/mouse/bam_to_36bp_bed/{acc}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.bed})

        python - <<'PY'
import re
import subprocess

bam = "{input.bam}"
out_bed = "{output.bed}"
read_len = 36
min_mapq = 10

def cigar_ref_len(cigar):
    total = 0
    for length, op in re.findall(r"(\d+)([MIDNSHP=X])", cigar):
        if op in {"M", "D", "N", "=", "X"}:
            total += int(length)
    return total

cmd = ["samtools", "view", "-F", "4", "-q", str(min_mapq), bam]

with subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True) as proc, open(out_bed + ".tmp", "w") as out:
    for line in proc.stdout:
        fields = line.rstrip("\n").split("\t")
        if len(fields) < 6:
            continue

        qname = fields[0]
        flag = int(fields[1])
        chrom = fields[2]
        pos0 = int(fields[3]) - 1
        mapq = fields[4]
        cigar = fields[5]

        if chrom == "*" or cigar == "*":
            continue

        ref_len = cigar_ref_len(cigar)
        if ref_len <= 0:
            continue

        strand = "-" if (flag & 16) else "+"
        right = pos0 + ref_len

        if strand == "+":
            start = pos0
            end = pos0 + read_len
        else:
            start = right - read_len
            end = right

        if start < 0 or end <= start:
            continue

        out.write(f"{chrom}\t{start}\t{end}\t{qname}\t{mapq}\t{strand}\n")

    ret = proc.wait()
    if ret != 0:
        raise SystemExit(ret)
PY

        sort -k1,1 -k2,2n {output.bed}.tmp > {output.bed}
        rm -f {output.bed}.tmp
        '''
        

# ============================================================
# 5. Merge replicates per mark
# ============================================================

def get_bed36_inputs_for_mark(wildcards):
    return [
        f'extra/datasets/mouse/chip_bed36/{acc}.mm9.36bp.bed'
        for acc in mark2accs[wildcards.mark]
    ]


rule merge_replicates_36bp:
    input:
        get_bed36_inputs_for_mark
    output:
        bed = 'extra/datasets/mouse/chip_bed36/ES-Bruce4-{mark}.merged.36bp.bed'
    benchmark:
        'benchmarks/mouse/merge_replicates_36bp/{mark}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.bed})

        cat {input} \
        | sort -k1,1 -k2,2n \
        > {output.bed}
        '''


# ============================================================
# 6. Subsample to 3 million reads
# ============================================================

rule subsample_3m_reads:
    input:
        bed = 'extra/datasets/mouse/chip_bed36/ES-Bruce4-{mark}.merged.36bp.bed'
    output:
        bed = 'extra/datasets/mouse/chip_bed36/ES-Bruce4-{mark}.merged.36bp.subsample3M.bed'
    params:
        n = 3000000,
        seed = 20240529
    benchmark:
        'benchmarks/mouse/subsample_3m_reads/{mark}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.bed})

        total=$(wc -l < {input.bed})

        if [ "$total" -le "{params.n}" ]; then
            echo "[WARN] {wildcards.mark}: total reads $total <= {params.n}; keeping all reads."
            cp {input.bed} {output.bed}
        else
            python - <<'PY'
import random

infile = "{input.bed}"
outfile = "{output.bed}.tmp"
n_keep = int("{params.n}")
seed = int("{params.seed}")

with open(infile) as f:
    total = sum(1 for _ in f)

random.seed(seed)
selected = set(random.sample(range(total), n_keep))

with open(infile) as f, open(outfile, "w") as out:
    for i, line in enumerate(f):
        if i in selected:
            out.write(line)
PY

            sort -k1,1 -k2,2n {output.bed}.tmp > {output.bed}
            rm -f {output.bed}.tmp
        fi
        '''


# ============================================================
# 7. genomecov bedGraph
# Use truncated and subsampled 36-bp BED as input
# ============================================================

rule bedtools_genomecov_mouse:
    input:
        bed = 'extra/datasets/mouse/chip_bed36/ES-Bruce4-{mark}.merged.36bp.subsample3M.bed',
        sizes = mm9_sizes
    output:
        bedgraph = 'extra/datasets/mouse/hist/ES-Bruce4-{mark}.mm9.subsample3M.bedGraph'
    benchmark:
        'benchmarks/mouse/bedtools_genomecov/{mark}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.bedgraph})

        bedtools genomecov \
            -i {input.bed} \
            -g {input.sizes} \
            -bg \
        | bedtools sort -i stdin \
        > {output.bedgraph}
        '''


# ============================================================
# 8. bedGraph to BigWig
# ============================================================

rule bedgraph_to_bigwig_mouse:
    input:
        bedgraph = 'extra/datasets/mouse/hist/ES-Bruce4-{mark}.mm9.subsample3M.bedGraph',
        sizes = mm9_sizes
    output:
        bw = 'extra/datasets/epigenetic/mm9/ES-Bruce4-{mark}.bw'
    benchmark:
        'benchmarks/mouse/bedgraph_to_bigwig/{mark}.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.bw})

        bedGraphToBigWig \
            {input.bedgraph} \
            {input.sizes} \
            {output.bw}
        '''


# ============================================================
# 9. Gencode vM1 TSS/promoter BED
# ============================================================

rule gencode_vm1_tss_promoter:
    input:
        gtf = gencode_vm1_gtf,
        sizes = mm9_sizes
    output:
        tss = 'extra/datasets/annotations/mm9/gencode.vM1.first_transcript_per_gene.tss.bed',
        promoter = 'extra/datasets/annotations/mm9/gencode.vM1.first_transcript_per_gene.promoter_40kb.bed'
    benchmark:
        'benchmarks/mouse/gencode_vm1_tss_promoter.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.tss})

        python benchmarks/revised_v2/reviewer3/scripts/make_tss_promoter_from_gencode.py \
            --gtf {input.gtf} \
            --chrom-sizes {input.sizes} \
            --out-tss-bed {output.tss} \
            --out-promoter-bed {output.promoter} \
            --mode first_transcript_per_gene \
            --gene-type protein_coding \
            --upstream 20000 \
            --downstream 20000
        '''