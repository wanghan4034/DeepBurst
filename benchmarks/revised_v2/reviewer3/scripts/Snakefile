import os

wildcard_constraints:
    mark = '[^.]+',
    acc = '[^.]+',

# ============================================================
# Reference files
# ============================================================

mm9_dir = 'extra/datasets/annotations/mm9'

mm9_fa_gz = f'{mm9_dir}/mm9.fa.gz'
mm9_fa = f'{mm9_dir}/mm9.fa'
mm9_fai = f'{mm9_dir}/mm9.fa.fai'
mm9_sizes = f'{mm9_dir}/mm9.fa.sizes'

gencode_vm1_gtf = f'{mm9_dir}/gencode.vM1.annotation.gtf.gz'

bwa_index_files = [
    mm9_fa + '.bwt',
    mm9_fa + '.pac',
    mm9_fa + '.ann',
    mm9_fa + '.amb',
    mm9_fa + '.sa',
]

# ============================================================
# Mouse ES-Bruce4 ChIP-seq accessions
# Chromoformer Supplementary Table 2
# ============================================================

marks = [
    'H3K4me1',
    'H3K4me3',
    'H3K9me3',
    'H3K27me3',
    'H3K36me3',
    'H3K27ac',
    'H3K9ac',
]


mark2accs = {
    'H3K4me1':  ['ENCFF001KEF'],
    'H3K4me3':  ['ENCFF001KER', 'ENCFF001KEQ'],
    'H3K9me3':  ['ENCFF001KDP', 'ENCFF001KDM'],
    'H3K27me3': ['ENCFF001KED', 'ENCFF001KEC'],
    'H3K36me3': ['ENCFF001KEE', 'ENCFF001KEI'],
    'H3K27ac':  ['ENCFF001KDQ', 'ENCFF001KDO'],
    'H3K9ac':   ['ENCFF001KDK', 'ENCFF001KDL'],
}


accs = sorted({acc for acc_list in mark2accs.values() for acc in acc_list})

acc2mark = {}
for mark, acc_list in mark2accs.items():
    for acc in acc_list:
        acc2mark[acc] = mark

# ============================================================
# Output targets
# ============================================================

fastqs = expand(
    'extra/datasets/mouse/fastq/{acc}.fastq.gz',
    acc=accs
)

sorted_bams = expand(
    'extra/datasets/mouse/chip_bam/{acc}.mm9.sorted.bam',
    acc=accs
)

bam_indexes = expand(
    'extra/datasets/mouse/chip_bam/{acc}.mm9.sorted.bam.bai',
    acc=accs
)

bed36_by_acc = expand(
    'extra/datasets/mouse/chip_bed36/{acc}.mm9.36bp.bed',
    acc=accs
)

merged_bed36 = expand(
    'extra/datasets/mouse/chip_bed36/ES-Bruce4-{mark}.merged.36bp.bed',
    mark=marks
)

subsampled_bed36 = expand(
    'extra/datasets/mouse/chip_bed36/ES-Bruce4-{mark}.merged.36bp.subsample3M.bed',
    mark=marks
)

coverage = expand(
    'extra/datasets/mouse/hist/ES-Bruce4-{mark}.mm9.subsample3M.bedGraph',
    mark=marks
)

bigwig = expand(
    'extra/datasets/epigenetic/mm9/ES-Bruce4-{mark}.bw',
    mark=marks
)

annotation = [
    'extra/datasets/annotations/mm9/gencode.vM1.first_transcript_per_gene.tss.bed',
    'extra/datasets/annotations/mm9/gencode.vM1.first_transcript_per_gene.promoter_40kb.bed',
]

ALL = [
    mm9_fa,
    mm9_sizes,
    gencode_vm1_gtf,
] + bwa_index_files + fastqs + bam_indexes + bed36_by_acc + merged_bed36 + subsampled_bed36 + coverage + bigwig + annotation


rule all:
    input:
        ALL


# ============================================================
# 0. Download and prepare mm9 / Gencode vM1 annotation
# ============================================================

rule download_mm9_fasta:
    output:
        fa_gz = mm9_fa_gz
    resources:
        network = 1
    benchmark:
        'benchmarks/mouse/download_mm9_fasta.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.fa_gz})

        wget -O {output.fa_gz} \
            "https://hgdownload.soe.ucsc.edu/goldenPath/mm9/bigZips/mm9.fa.gz"
        '''


rule unzip_mm9_fasta:
    input:
        fa_gz = mm9_fa_gz
    output:
        fa = mm9_fa
    benchmark:
        'benchmarks/mouse/unzip_mm9_fasta.tsv'
    shell:
        r'''
        mkdir -p $(dirname {output.fa})
        gunzip -c {input.fa_gz} > {output.fa}
        '''


rule samtools_faidx_mm9:
    input:
        fa = mm9_fa
    output:
        fai = mm9_fai
    benchmark:
